# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is org-level rather than workspace-scoped.
# Symptom: 400 "This API key is not scoped to a workspace".
# Find the ID in the Console URL while a workspace is open.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
